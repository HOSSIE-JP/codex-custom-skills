{
  "formatVersion": 1,
  "projectId": "replace-with-project-id",
  "title": "仮題",
  "target": {
    "engine": "GB Studio",
    "version": "4.3.1",
    "hardware": "Game Boy Color",
    "colorMode": "color"
  },
  "experience": {
    "firstPlayMinutes": 10,
    "audience": "replace-with-audience",
    "tone": [
      "会話劇"
    ],
    "contentBoundaries": []
  },
  "branching": {
    "choiceCount": 1,
    "endingCount": 1,
    "joinPolicy": "各選択直後に専用反応を再生してから共通ノードへ合流する",
    "optionPattern": [
      2
    ],
    "historyCount": 2,
    "stateVariables": [
      "trust"
    ],
    "choiceLayout": "dialogue-width",
    "menuInputReleaseFrames": 6
  },
  "presentation": {
    "screen": [
      160,
      144
    ],
    "messageArtArea": [
      160,
      96
    ],
    "messageAreaHeight": 48,
    "fullscreenStill": [
      160,
      144
    ],
    "proportionPolicy": "replace-with-fixed-or-explicitly-variable-policy",
    "outfitSilhouettePolicy": "recurring cast must remain distinguishable at 160 pixels"
  },
  "gbConstraints": {
    "maxColorsPer8x8Tile": 4,
    "maxBackgroundPalettes": 7,
    "maxUniqueTiles": 384,
    "recommendedContentPalettes": 5,
    "recommendedTitlePalettes": 4,
    "globalArtColors": 32,
    "dithering": false,
    "neighborCoherentPaletteAssignment": true
  },
  "externalGates": [
    "physical-flash-cart"
  ],
  "externalReviewPack": {
    "required": true,
    "gate": "after-complete-scenario-before-art-and-generated-resources",
    "outputDir": "source/external-review",
    "files": [
      "01_concept.md",
      "02_character_settings.md",
      "03_scenario_script.md"
    ],
    "manifest": "review-manifest.json",
    "selfReview": {
      "required": true,
      "passes": [
        "mechanical",
        "readAloud",
        "characterVoice",
        "expositionAndBranchJoins"
      ],
      "status": "required"
    },
    "userConsultation": {
      "required": true,
      "status": "pending-user-decision",
      "allowedStatuses": [
        "pending-user-decision",
        "awaiting-external-review",
        "proceeding-provisionally",
        "waived-by-user",
        "complete"
      ],
      "externalTransmissionRequiresExplicitApproval": true,
      "externalTransmissionApproved": false,
      "note": ""
    },
    "regenerateWhen": [
      "project-brief",
      "character-bible",
      "scenario",
      "language-rules",
      "review-decision"
    ]
  }
}
